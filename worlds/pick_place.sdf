<?xml version="1.0"?>
<sdf version="1.9"><world name="pick_place">
  <physics name="physics" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
  <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
  <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
  <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.2 -1</direction><cast_shadows>true</cast_shadows></light>
  <model name="ground"><static>true</static><link name="ground_link">
    <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
    <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
  </link></model>
  <model name="box_a"><static>true</static><pose>0.50 0.50 0.10 0 0 0</pose><link name="link">
    <collision name="collision"><geometry><box><size>0.30 0.30 0.20</size></box></geometry></collision>
    <visual name="visual"><geometry><box><size>0.30 0.30 0.20</size></box></geometry><material><ambient>0.15 0.3 0.8 1</ambient><diffuse>0.15 0.3 0.8 1</diffuse></material></visual>
  </link></model>
  <model name="box_b">
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose><publish_link_pose>false</publish_link_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>50</update_frequency>
    </plugin><pose>0.40 -0.25 0.025 0 0 0</pose><link name="link">
    <inertial><mass>0.05</mass><inertia><ixx>0.0000208333</ixx><iyy>0.0000208333</iyy><izz>0.0000208333</izz></inertia></inertial>
    <collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
    <visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.9 0.2 0.1 1</ambient><diffuse>0.9 0.2 0.1 1</diffuse></material></visual>
  </link></model>
</world></sdf>
